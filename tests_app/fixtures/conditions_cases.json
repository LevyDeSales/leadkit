{
  "about": "Casos que o avaliador de condições (app/forms/definition/conditions.py) e o JavaScript da página pública resolvem igual. Cada caso dá as respostas como o envio as traz (texto, ou lista nas escolhas múltiplas) e o resultado: as perguntas visíveis, na ordem da definição, e as opções disponíveis de cada pergunta de escolha visível. Regras de leitura: a resposta vale sem os espaços das pontas; texto em branco ou nenhuma opção é não respondida; numa escolha múltipla, um texto vale como a lista dessa opção; o que está escondido (pergunta ou opção) conta como não respondido para as regras seguintes; contains compara com maiúsculas e minúsculas como estão.",
  "questions": [
    {
      "name": "situacao",
      "kind": "choice",
      "options": [
        {"value": "clt"},
        {"value": "autonomo"},
        {"value": "escritorio"},
        {"value": "estudante"}
      ]
    },
    {
      "name": "clientes",
      "kind": "choice",
      "show_when": {
        "mode": "all",
        "rules": [
          {"field": "situacao", "operator": "in", "value": ["clt", "estudante"]}
        ]
      },
      "options": [
        {"value": "sim"},
        {"value": "nao"}
      ]
    },
    {
      "name": "carteira",
      "kind": "choice",
      "show_when": {
        "mode": "any",
        "rules": [
          {"field": "situacao", "operator": "in", "value": ["autonomo", "escritorio"]},
          {"field": "clientes", "operator": "equals", "value": "sim"}
        ]
      },
      "options": [
        {
          "value": "zero",
          "show_when": {
            "mode": "all",
            "rules": [
              {"field": "situacao", "operator": "in", "value": ["autonomo", "escritorio"]}
            ]
          }
        },
        {"value": "ate_10"},
        {"value": "mais_10"}
      ]
    },
    {
      "name": "zero_motivo",
      "kind": "text",
      "show_when": {
        "mode": "all",
        "rules": [
          {"field": "carteira", "operator": "equals", "value": "zero"}
        ]
      }
    },
    {
      "name": "equipe",
      "kind": "choice",
      "show_when": {
        "mode": "all",
        "rules": [
          {"field": "carteira", "operator": "in", "value": ["ate_10", "mais_10"]}
        ]
      },
      "options": [
        {"value": "so_eu"},
        {"value": "time"}
      ]
    },
    {
      "name": "nome",
      "kind": "text"
    },
    {
      "name": "dores",
      "kind": "choices",
      "options": [
        {"value": "preco"},
        {"value": "prazo"},
        {"value": "outra"}
      ]
    },
    {
      "name": "outra_dor",
      "kind": "textarea",
      "show_when": {
        "mode": "all",
        "rules": [
          {"field": "dores", "operator": "contains", "value": "outra"}
        ]
      }
    },
    {
      "name": "cidade",
      "kind": "text",
      "show_when": {
        "mode": "all",
        "rules": [
          {"field": "nome", "operator": "contains", "value": "Paulo"}
        ]
      }
    },
    {
      "name": "canal",
      "kind": "choices",
      "options": [
        {"value": "email"},
        {"value": "whatsapp"},
        {"value": "telefone"}
      ]
    },
    {
      "name": "canal_extra",
      "kind": "text",
      "show_when": {
        "mode": "all",
        "rules": [
          {"field": "canal", "operator": "in", "value": ["whatsapp", "telefone"]}
        ]
      }
    },
    {
      "name": "observacao",
      "kind": "text",
      "show_when": {
        "mode": "all",
        "rules": [
          {"field": "clientes", "operator": "equals", "value": "sim"}
        ]
      }
    }
  ],
