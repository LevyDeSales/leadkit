# Configuração do app na stack Swarm (deploy/swarm/stack.yaml). Copie para app.env (ignorado pelo
# git) e preencha. Os segredos ficam vazios de propósito: sem a maioria deles o app se recusa a
# subir, mas as chaves do S3 vazias só falham no primeiro upload de PDF.
# Lido pelo Docker sem passar pelo shell: escreva os valores SEM aspas (o hash do admin, com `$`,
# entra como está). Guia: deploy/swarm/README.md.
# --- Stack ---------------------------------------------------------------------------------------
# Nome desta stack no Swarm, lido pelo deploy.sh. Defina-o explicitamente. Ele entra nos
# nomes do Traefik, nas redes e nos volumes: duas stacks no mesmo servidor precisam de nomes
# diferentes, senão o Traefik descarta as duas. Letras minúsculas, dígitos e hífen, até 40
# caracteres. Não mude o de uma stack no ar: a stack nova nasceria com outro banco. Segunda stack:
# deploy/swarm/README.md, "Duas stacks no mesmo servidor".
STACK_NAME=leadkit

# --- App -----------------------------------------------------------------------------------------
APP_ENV=production
# Mesmo usuário, senha e banco do db.env; o host é o nome completo do serviço, <STACK_NAME>_db
# (leadkit_db na stack padrão).
DATABASE_URL=postgresql+psycopg://leadkit:TROQUE_PELA_SENHA@leadkit_db:5432/leadkit
# https e o domínio do router desta stack (o deploy.sh o usa como DOMAIN): um domínio por stack.
PUBLIC_BASE_URL=https://planos.example.test
# Um ou mais segredos (32+ caracteres) separados por vírgula; o primeiro assina os links do lead.
# Gere com `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
TOKEN_SECRETS=
LINK_TTL_DAYS=30

# --- Plano (OpenAI) e PDF ------------------------------------------------------------------------
LLM_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Limite de cada chamada e, mais curto, para abrir a conexão (por endereço IP tentado).
OPENAI_TIMEOUT_SECONDS=120
OPENAI_CONNECT_TIMEOUT_SECONDS=10
# Opcional: modelo tentado uma vez depois de uma falha retentável do principal. Vazia ou comentada,
# não há fallback.
# OPENAI_FALLBACK_MODEL=
PDF_MODE=weasyprint

# --- PDFs no S3 ----------------------------------------------------------------------------------
# A chave precisa de s3:PutObject, s3:GetObject e s3:DeleteObject (a retenção apaga PDFs) só neste
# bucket. Sem versionamento no bucket (ou com regra que expire as versões antigas): senão o PDF
# apagado continua guardado. Endpoint só para R2/MinIO (no R2, S3_REGION=auto).
STORAGE_MODE=s3
S3_BUCKET=
# No Cloudflare R2: S3_REGION=auto e S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Webhook (entrega do plano pronto) -----------------------------------------------------------
# O destino (a URL do receptor e o segredo) é definido no admin, em /admin/destinations; contrato em
# app/adapters/webhook.py. Esta chave Fernet cifra o segredo de cada destino no banco e é
# obrigatória quando existe destino. Uma ou mais, separadas por vírgula: a primeira cifra e todas
# abrem. Trocar leva dois deploys (SECURITY.md). Como gerar: app/README.md, "Destinos do webhook".
WEBHOOK_ENCRYPTION_KEY=
# Só na primeira subida: URL/segredo criam o destino padrão com finalidade explicitada.
# WEBHOOK_PURPOSE=internal autoriza o envelope interno; participante exige atestação operacional.
# Depois são ignorados. Rollback abaixo do piso de compatibilidade é recusado: README.md.
WEBHOOK_PURPOSE=
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Hatchet Cloud -------------------------------------------------------------------------------
# Token de API do tenant (painel do Hatchet > Settings > API Tokens). O mesmo para API e worker.
HATCHET_CLIENT_TOKEN=
HATCHET_TRIGGER_TIMEOUT_SECONDS=3
# Slots por processo de worker. O PDF sai um por vez por processo, então mais slots não aceleram.
WORKER_SLOTS=10
# Crons (UTC). Vazio desliga; cada execução conta na cota diária do plano gratuito do Hatchet.
RECONCILE_CRON=*/2 * * * *
RETENTION_CRON=0 6 * * *
# Opcional: link da execução no painel do Hatchet, com o id trocado por {run_id}.
HATCHET_RUN_URL_TEMPLATE=

# --- Retenção LGPD (app.retention) ---------------------------------------------------------------
# Dias até apagar o pedido inteiro (respostas, contato, plano, PDF e entregas), contados da última
# mudança do job, e dias até apagar só o arquivo do PDF, contados da geração. Nada sai antes de o
# link da lead vencer, e o app não sobe com RETENTION_PDF_DAYS menor que LINK_TTL_DAYS, nem com
# RETENTION_DAYS menor que RETENTION_PDF_DAYS. Os padrões foram aprovados pelo dono; a política de
# privacidade traz os mesmos prazos.
RETENTION_DAYS=60
RETENTION_PDF_DAYS=30

# --- Limites dos envios públicos (app.intake) ----------------------------------------------------
# Cada envio anônimo gasta a OpenAI e escreve para o e-mail digitado. Por e-mail da lead em cada
# formulário, no máximo SUBMISSION_LIMIT_PER_EMAIL envios em SUBMISSION_LIMIT_WINDOW_HOURS horas
# (429); com SUBMISSION_LIMIT_QUEUE pedidos em andamento (queued ou running, de todos os
# formulários), o envio novo espera (503). Os dois respondem com Retry-After, e reenviar a mesma
# chave de idempotência não conta. O app não sobe com o teto da fila menor que WORKER_SLOTS, nem
# com a janela maior que RETENTION_DAYS em horas. Não deixe vazio: o valor precisa ser um número.
SUBMISSION_LIMIT_PER_EMAIL=3
SUBMISSION_LIMIT_WINDOW_HOURS=24
SUBMISSION_LIMIT_QUEUE=200

# --- Painel admin (/admin) -----------------------------------------------------------------------
# Os três juntos ou nenhum (sem eles o login fica recusado). Como gerar: app/README.md.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- API de admin (/admin/api/v1) ----------------------------------------------------------------
# Chamadas por minuto de cada chave de API (rajada de 30; a operação pesada custa 5 chamadas).
# Passou, a API responde 429 com Retry-After. O balde é por chave e fica na memória do processo:
# some ao reiniciar e, com mais de uma réplica da API, vale por réplica. Não deixe vazio.
API_RATE_LIMIT_PER_MINUTE=120

# --- Opcionais (o padrão serve) ------------------------------------------------------------------
# De quem a API aceita X-Forwarded-For/Proto (deploy/entrypoint.sh), o IP real que o bloqueio de
# login usa. Sem a linha, o deploy.sh lê a(s) sub-rede(s) da rede traefik-public a cada deploy
# (README.md, "Confiar no Traefik"). Ponha um valor só para trocar isso: redes (CIDR) e endereços
# separados por vírgula, sem espaços, ou * para aceitar qualquer origem (o que a stack fazia antes).
# FORWARDED_ALLOW_IPS=10.0.1.0/24

# Limite de envios no Traefik: POST em /p/ e /v1/forms/, por IP (README.md, "Limite de envios").
# Pedidos por minuto e rajada. Os padrões abaixo valem sem a linha; o deploy.sh lê os dois daqui.
# Um IP pode ser um escritório ou uma operadora inteira: se leads receberem 429, suba os dois.
# RATE_LIMIT_AVERAGE=10
# RATE_LIMIT_BURST=20

# Memória de cada serviço (README.md, "Limites de memória"): o teto (LIMIT), acima do qual o
# contêiner é encerrado e subido de novo, e a reserva (RESERVATION), que o Swarm separa no servidor.
# Tamanhos como 512M ou 1G. Os padrões abaixo, generosos, valem sem a linha; o deploy.sh lê daqui.
# API_MEMORY_LIMIT=512M
# API_MEMORY_RESERVATION=128M
# WORKER_MEMORY_LIMIT=1536M
# WORKER_MEMORY_RESERVATION=512M
# DB_MEMORY_LIMIT=1G
# DB_MEMORY_RESERVATION=256M
