# Postgres da stack Swarm (stack.yaml). Copie para db.env (ignorado pelo git) e preencha.
# Lido pelo Docker sem passar pelo shell: escreva os valores sem aspas.
POSTGRES_USER=leadkit
POSTGRES_DB=leadkit
# Gere com `openssl rand -hex 24` (hex: entra também na DATABASE_URL do app.env sem escape).
POSTGRES_PASSWORD=
