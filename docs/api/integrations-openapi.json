{
  "components": {
    "schemas": {
      "AttendanceData": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "enum": [
              "attendance",
              "corrected"
            ],
            "title": "Change",
            "type": "string"
          },
          "meeting_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Meeting Id",
            "type": "string"
          },
          "meeting_revision": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Meeting Revision",
            "type": "integer"
          },
          "status": {
            "enum": [
              "attended",
              "no_show",
              "unknown"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "meeting_id",
          "meeting_revision",
          "status",
          "change"
        ],
        "title": "AttendanceData",
        "type": "object"
      },
      "Author": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "human",
              "service",
              "participant"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "title": "Author",
        "type": "object"
      },
      "ContextData": {
        "additionalProperties": false,
        "properties": {
          "assignee_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee Id"
          },
          "contact_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Id"
          },
          "conversation_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "required": [
          "contact_id",
          "conversation_id",
          "assignee_id"
        ],
        "title": "ContextData",
        "type": "object"
      },
      "Entity": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "context",
              "invitation",
              "meeting",
              "attendance",
              "notification",
              "receipt"
            ],
            "title": "Kind",
            "type": "string"
          },
          "revision": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "id",
          "revision"
        ],
        "title": "Entity",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "channel": {
            "enum": [
              "chat",
              "email",
              "sms",
              "voice",
              "system",
              "other"
            ],
            "title": "Channel",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "correlation_record",
              "dispatch_record",
              "calendar_record",
              "attendance_record",
              "provider_delivery_receipt",
              "participant_ack",
              "operator_correction"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "channel",
          "kind",
          "id",
          "author"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InvitationData": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "notification_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Notification Id",
            "type": "string"
          }
        },
        "required": [
          "conversation_id",
          "notification_id"
        ],
        "title": "InvitationData",
        "type": "object"
      },
      "JourneyEventInput": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContextData"
              },
              {
                "$ref": "#/components/schemas/InvitationData"
              },
              {
                "$ref": "#/components/schemas/MeetingData"
              },
              {
                "$ref": "#/components/schemas/AttendanceData"
              },
              {
                "$ref": "#/components/schemas/NotificationData"
              },
              {
                "$ref": "#/components/schemas/ReceiptData"
              },
              {
                "$ref": "#/components/schemas/WithdrawData"
              }
            ],
            "title": "Data"
          },
          "entity": {
            "$ref": "#/components/schemas/Entity"
          },
          "event_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Event Id",
            "type": "string"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "reference_id": {
            "format": "uuid",
            "title": "Reference Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "source_revision": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Source Revision",
            "type": "integer"
          },
          "type": {
            "enum": [
              "correlation.linked",
              "invitation.sent",
              "meeting.state_reported",
              "meeting.attendance_recorded",
              "notification.delivery_reported",
              "participant.receipt_acknowledged",
              "entity.withdrawn"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "source_revision",
          "event_id",
          "reference_id",
          "type",
          "entity",
          "occurred_at",
          "evidence",
          "data"
        ],
        "title": "JourneyEventInput",
        "type": "object"
      },
      "JourneyEventReceipt": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "projection_effect": {
            "enum": [
              "current",
              "historical",
              "withdrawn"
            ],
            "title": "Projection Effect",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "replay": {
            "title": "Replay",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "received_at",
          "replay",
          "projection_effect"
        ],
        "title": "JourneyEventReceipt",
        "type": "object"
      },
      "MeetingData": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "enum": [
              "created",
              "rescheduled",
              "timezone_corrected",
              "corrected"
            ],
            "title": "Change",
            "type": "string"
          },
          "ends_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ends At"
          },
          "starts_at": {
            "format": "date-time",
            "title": "Starts At",
            "type": "string"
          },
          "status": {
            "enum": [
              "scheduled",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          },
          "timezone": {
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "status",
          "starts_at",
          "ends_at",
          "timezone",
          "change"
        ],
        "title": "MeetingData",
        "type": "object"
      },
      "NotificationData": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "status": {
            "enum": [
              "accepted",
              "confirmed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "conversation_id"
        ],
        "title": "NotificationData",
        "type": "object"
      },
      "ReceiptData": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "notification_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Notification Id",
            "type": "string"
          }
        },
        "required": [
          "conversation_id",
          "notification_id"
        ],
        "title": "ReceiptData",
        "type": "object"
      },
      "ResolveHandoffRequest": {
        "additionalProperties": false,
        "properties": {
          "reference": {
            "format": "password",
            "maxLength": 47,
            "minLength": 47,
            "pattern": "^lkh_[A-Za-z0-9_-]{43}$",
            "title": "Reference",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "reference"
        ],
        "title": "ResolveHandoffRequest",
        "type": "object"
      },
      "ResolvedHandoff": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "form_slug": {
            "title": "Form Slug",
            "type": "string"
          },
          "form_version_number": {
            "title": "Form Version Number",
            "type": "integer"
          },
          "generation": {
            "enum": [
              "none",
              "pdf"
            ],
            "title": "Generation",
            "type": "string"
          },
          "projection": {
            "const": "correlation.v1",
            "default": "correlation.v1",
            "title": "Projection",
            "type": "string"
          },
          "purpose": {
            "const": "support",
            "default": "support",
            "title": "Purpose",
            "type": "string"
          },
          "receiver_id": {
            "format": "uuid",
            "title": "Receiver Id",
            "type": "string"
          },
          "receiver_revision": {
            "title": "Receiver Revision",
            "type": "integer"
          },
          "reference_id": {
            "format": "uuid",
            "title": "Reference Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "submission_id": {
            "format": "uuid",
            "title": "Submission Id",
            "type": "string"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          }
        },
        "required": [
          "reference_id",
          "submission_id",
          "form_slug",
          "form_version_number",
          "generation",
          "receiver_id",
          "receiver_revision",
          "submitted_at",
          "expires_at"
        ],
        "title": "ResolvedHandoff",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WithdrawData": {
        "additionalProperties": false,
        "properties": {
          "reason_code": {
            "enum": [
              "incorrect",
              "duplicate",
              "erasure_request",
              "other"
            ],
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "reason_code"
        ],
        "title": "WithdrawData",
        "type": "object"
      }
    },
    "securitySchemes": {
      "EventCredentialAuth": {
        "description": "Credencial exclusiva lke_, escopo journey:events:write. Fontes pausadas ou credenciais inválidas recebem401 antes do corpo.",
        "scheme": "bearer",
        "type": "http"
      },
      "IntegrationCredentialAuth": {
        "description": "Credencial própria lki_ com escopo handoffs:resolve; chaves administrativas não são aceitas.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "API de integrações Leadkit",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/handoffs/resolve": {
      "post": {
        "description": "Resolve correlation.v1; não identifica a participante nem concede acesso ao plano.",
        "operationId": "resolve_handoff_reference",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveHandoffRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolvedHandoff"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "IntegrationCredentialAuth": []
          }
        ],
        "summary": "Resolve Handoff Reference",
        "tags": [
          "Encaminhamentos"
        ]
      }
    },
    "/journey/events": {
      "post": {
        "description": "Persiste um snapshot autenticado; não confirma sua verdade comercial nem libera plano ou envia mensagens.",
        "operationId": "ingest_journey_event",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JourneyEventInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JourneyEventReceipt"
                }
              }
            },
            "description": "Repetição exata."
          },
          "201": {
            "description": "Declaração persistida."
          },
          "401": {
            "description": "invalid_credentials"
          },
          "403": {
            "description": "source_not_authorized"
          },
          "404": {
            "description": "correlation_unavailable"
          },
          "409": {
            "description": "event_conflict, entity_revision_conflict ou source_revision_conflict"
          },
          "413": {
            "description": "payload_too_large"
          },
          "415": {
            "description": "unsupported_media_type"
          },
          "422": {
            "description": "validation_failed"
          },
          "429": {
            "description": "rate_limited"
          },
          "503": {
            "description": "temporarily_unavailable"
          }
        },
        "security": [
          {
            "EventCredentialAuth": []
          }
        ],
        "summary": "Registrar declaração externa",
        "tags": [
          "Jornada"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/integrations/v1"
    }
  ]
}
