{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ResolveHandoffRequest": {
        "additionalProperties": false,
        "properties": {
          "reference": {
            "format": "password",
            "maxLength": 47,
            "minLength": 47,
            "pattern": "^lkh_[A-Za-z0-9_-]{43}$",
            "title": "Reference",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "reference"
        ],
        "title": "ResolveHandoffRequest",
        "type": "object"
      },
      "ResolvedHandoff": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "form_slug": {
            "title": "Form Slug",
            "type": "string"
          },
          "form_version_number": {
            "title": "Form Version Number",
            "type": "integer"
          },
          "generation": {
            "enum": [
              "none",
              "pdf"
            ],
            "title": "Generation",
            "type": "string"
          },
          "projection": {
            "const": "correlation.v1",
            "default": "correlation.v1",
            "title": "Projection",
            "type": "string"
          },
          "purpose": {
            "const": "support",
            "default": "support",
            "title": "Purpose",
            "type": "string"
          },
          "receiver_id": {
            "format": "uuid",
            "title": "Receiver Id",
            "type": "string"
          },
          "receiver_revision": {
            "title": "Receiver Revision",
            "type": "integer"
          },
          "reference_id": {
            "format": "uuid",
            "title": "Reference Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "submission_id": {
            "format": "uuid",
            "title": "Submission Id",
            "type": "string"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          }
        },
        "required": [
          "reference_id",
          "submission_id",
          "form_slug",
          "form_version_number",
          "generation",
          "receiver_id",
          "receiver_revision",
          "submitted_at",
          "expires_at"
        ],
        "title": "ResolvedHandoff",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "IntegrationCredentialAuth": {
        "description": "Credencial própria lki_ com escopo handoffs:resolve; chaves administrativas não são aceitas.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "API de integrações Leadkit",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/handoffs/resolve": {
      "post": {
        "description": "Resolve correlation.v1; não identifica a participante nem concede acesso ao plano.",
        "operationId": "resolve_handoff_reference",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveHandoffRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolvedHandoff"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "IntegrationCredentialAuth": []
          }
        ],
        "summary": "Resolve Handoff Reference",
        "tags": [
          "Encaminhamentos"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/integrations/v1"
    }
  ]
}
