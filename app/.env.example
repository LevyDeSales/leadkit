# App (FastAPI + Hatchet), desenvolvimento local. Copie para `.env` na raiz do projeto e ajuste.
# A API e o worker leem este arquivo; o alembic, não: exporte DATABASE_URL antes das migrations.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://leadkit@127.0.0.1:5432/leadkit_app
PUBLIC_BASE_URL=http://localhost:8000
# Um ou mais segredos aleatórios (32+ caracteres) separados por vírgula; o primeiro assina os links.
TOKEN_SECRETS=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
LINK_TTL_DAYS=30

# Modos de teste (proibidos com APP_ENV=production). Os serviços reais estão nos blocos abaixo.
LLM_MODE=fake
PDF_MODE=fake
STORAGE_MODE=local
LOCAL_STORAGE_DIR=var/artifacts

# LLM_MODE=openai: modelo principal e, opcional, um fallback tentado uma vez após falha retentável.
# Timeout por chamada e, mais curto, para abrir a conexão (vale por endereço IP tentado); o SDK
# não repete (quem repete é o Hatchet). No pior caso são 4 chamadas seguidas (principal e reserva,
# cada uma com um reparo), e a task `plan` é cancelada em 9 min: o app recusa na subida um
# OPENAI_TIMEOUT_SECONDS acima de 120 s com reserva (240 s sem ela). A conta fica em
# app/plan_timeout.py.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=
# OPENAI_FALLBACK_MODEL=
# OPENAI_TIMEOUT_SECONDS=120
# OPENAI_CONNECT_TIMEOUT_SECONDS=10

# PDFs no S3 (STORAGE_MODE=s3). Endpoint só para R2/MinIO (no R2, S3_REGION=auto). Sem chave e
# segredo vale a cadeia padrão da AWS (AWS_*, perfil, role); com credencial temporária o link
# direto de 24 h do webhook expira junto com ela.
# S3_BUCKET=leadkit-artifacts
# S3_REGION=sa-east-1
# S3_ENDPOINT_URL=https://<conta>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...

# Entrega do resultado: o destino do webhook (URL e segredo) é definido no admin, em
# /admin/destinations. Esta chave Fernet cifra o segredo de cada destino no banco; uma ou mais,
# separadas por vírgula (a primeira cifra). Sem ela, o admin não cria destinos. Como gerar:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WEBHOOK_ENCRYPTION_KEY=
# Só na primeira subida depois da migration do destino no admin: os dois viram o destino padrão, se
# ainda não houver um, e exigem a chave acima. Depois disso, são ignorados.
# WEBHOOK_URL=https://seu-endpoint/webhook
# WEBHOOK_SECRET=segredo-compartilhado-com-o-receptor

# Reconciliador: ligado por padrão só com APP_ENV=production. Vazio desliga. O agendamento lê
# RECONCILE_CRON, RETENTION_CRON e APP_ENV só do ambiente do processo: definidos neste arquivo, eles
# não ligam nem desligam cron nenhum.
# RECONCILE_CRON=*/2 * * * *

# Retenção LGPD (app.retention): o pedido inteiro sai RETENTION_DAYS depois da última mudança do
# job, e o arquivo do PDF, RETENTION_PDF_DAYS depois de gerado; nada sai antes de o link vencer.
# O app não sobe com o prazo do PDF menor que LINK_TTL_DAYS, nem com o do pedido menor que o do PDF.
# O cron diário segue a regra do reconciliador (só em produção por padrão; vazio desliga).
# RETENTION_DAYS=60
# RETENTION_PDF_DAYS=30
# RETENTION_CRON=0 6 * * *

# Limites dos envios públicos (app.intake), por e-mail da lead em cada formulário e pelo teto de
# pedidos em andamento (queued ou running). Passou, a API responde 429 ou 503 com Retry-After;
# reenviar a mesma chave de idempotência não conta. O app não sobe com o teto da fila menor que
# WORKER_SLOTS, nem com a janela maior que RETENTION_DAYS em horas.
# SUBMISSION_LIMIT_PER_EMAIL=3
# SUBMISSION_LIMIT_WINDOW_HOURS=24
# SUBMISSION_LIMIT_QUEUE=200

# Worker: quantas tasks o processo roda ao mesmo tempo (de 1 a 200). O teto da fila de envios acima
# não pode ficar abaixo disso.
# WORKER_SLOTS=10

# Painel admin (/admin). Os três juntos; sem eles o login fica recusado. Como gerar: app/README.md.
# O hash tem `$`: mantenha as aspas simples.
# ADMIN_USERNAME=operacao
# ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
# ADMIN_SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# Opcional: URL de uma execução no painel do Hatchet com o id trocado por {run_id}.
# HATCHET_RUN_URL_TEMPLATE=https://.../{run_id}

# API de admin (/admin/api/v1): chamadas por minuto de cada chave de API (rajada de 30; a operação
# pesada custa 5 chamadas). Passou, a API responde 429 com Retry-After. É um balde por chave na
# memória do processo: some ao reiniciar e, com mais de uma réplica da API, vale por réplica.
# API_RATE_LIMIT_PER_MINUTE=120

# Quanto a API e o admin esperam o Hatchet aceitar um disparo, em segundos, antes de desistir.
# HATCHET_TRIGGER_TIMEOUT_SECONDS=3

# O token do Hatchet fica fora daqui, em `.env.hatchet` (ignorado pelo git):
# HATCHET_CLIENT_TOKEN=...

# Marca privada externa: montar somente leitura na API e no worker; veja docs/branding.md.
# LEADKIT_BRAND_DIR=/caminho/absoluto/marca
